# ---- 站点配置 ----
# 网易云歌单 ID（服务端读取）
PLAYLIST_ID=13246943556

# 卡片右下角外链（会打包进浏览器，必须用 NEXT_PUBLIC_ 前缀；留空则不显示）
NEXT_PUBLIC_GITHUB_URL=https://github.com/meorionel/meorion.moe
NEXT_PUBLIC_X_URL=https://x.com/meorionel

# ---- 网易云 Cookie ----
# 只在 Next 服务端读取，不会发到浏览器。
# 复制为 .env.local 后填写；.env.local 已被 gitignore。
#
# 完整 Cookie（推荐，和浏览器 F12 里复制的一致）：
# NETEASE_COOKIE=MUSIC_U=xxxx; __csrf=yyyy; ...
#
# 或者只填 MUSIC_U：
# MUSIC_U=xxxx

# ---- 心率（LitterLove）----
# LitterLove-server 的根地址（不要带 /api/state）；只在服务端读取，
# 浏览器只会请求同源的 /api/heart，拿不到这个地址。
LITTERLOVE_URL=https://litterlove.meorion.moe
