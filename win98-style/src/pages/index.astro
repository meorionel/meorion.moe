---
import Layout from "@/layouts/index.astro";
import { CONFIG } from "@/config";
import { FRIENDS, FRIENDS_BUTTON } from "@/friends";
import { getEntry, render } from "astro:content";

const handleYearOfBirth = (yob: number) => {
	return new Date().getFullYear() - yob;
};

const entryZh = await getEntry("index", "indexzh");
const entryEn = await getEntry("index", "indexen");

if (!entryZh || !entryEn) throw new Error("Localized index entries not found");

const { Content: ContentZh } = await render(entryZh);
const { Content: ContentEn } = await render(entryEn);
---

<Layout
	title={`${CONFIG.author.name} | ${CONFIG.site.title}`}
	description={CONFIG.author.bio}
	image={CONFIG.author.avatar}
>
	<div class="flex flex-col gap-2.5">
		<div class="flex gap-2.5">
			<img src={CONFIG.author.avatar} alt={CONFIG.author.name} class="size-18" />
			<div class="flex flex-col gap-4">
				<div>
					<p>{CONFIG.author.name}</p>
					<p>
						<span class="lang-zh">{CONFIG.author.gender} ☁ {handleYearOfBirth(CONFIG.author.yob)} 岁</span>
						<span class="lang-en">{CONFIG.author.gender} ☁ {handleYearOfBirth(CONFIG.author.yob)} years old</span>
					</p>
				</div>
				<div class="article">
					<div class="lang-zh">
						<ContentZh />
					</div>
					<div class="lang-en">
						<ContentEn />
					</div>
				</div>
			</div>
		</div>
		<div class="md:grid grid-cols-6 gap-2 max-md:flex flex-wrap">
			{
				FRIENDS_BUTTON.map((item) => (
					<a href={item.url} target="_blank" rel="noopener noreferrer">
						<img src={item.avatar} alt={item.name} class="w-22 h-7.75" />
					</a>
				))
			}
		</div>
		<div class="md:grid grid-cols-10 gap-2 max-md:flex flex-wrap">
			{
				FRIENDS.map((item) => (
					<a href={item.url} target="_blank" rel="noopener noreferrer">
						<img src={item.avatar} alt={item.name} class="size-12" />
					</a>
				))
			}
		</div>
	</div>
</Layout>
